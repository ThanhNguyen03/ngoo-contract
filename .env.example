# ==========================================
# ngoo-contract Environment Variables
# ==========================================

# --- Deployer ---
# Private key of the wallet that will deploy the contract (needs tBNB for gas).
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# --- Signer ---
# PUBLIC ADDRESS of the server-side ECDSA signer wallet (from ngoo-server-2025 NGOO_SIGNER).
# This is the public address only — the private key stays in the server's env.
SIGNER_ADDRESS=0xYOUR_SIGNER_WALLET_ADDRESS_HERE

# --- RPC ---
# BNB Testnet RPC URL (free official endpoint — no API key required).
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# --- BscScan (optional — for contract verification) ---
# Get a free API key at: https://testnet.bscscan.com/myapikey
BSCSCAN_API_KEY=YOUR_BSCSCAN_API_KEY_HERE

# --- Gas Reporter (optional) ---
# REPORT_GAS=true
